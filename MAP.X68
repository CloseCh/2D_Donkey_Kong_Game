; =============================================================================================
; MAP
; =============================================================================================

; ------------------------------------------------------------------------------
MAPUPD
; SWITCHES A CELL MAP VALUE IF POINTED BY MOUSE AND CLICKED.
; INPUT    : NONE
; OUTPUT   : NONE
; MODIFIES : NONE
; ------------------------------------------------------------------------------
            RTS


; ------------------------------------------------------------------------------
MAPPLOT
; PLOTS THE MAP
; INPUT    : NONE
; OUTPUT   : NONE
; MODIFIES : NONE
; ------------------------------------------------------------------------------

            MOVEM.L D0-D6/A0,-(A7)

            ; SE DEFINE COLORES
            MOVE.B  #80,D0
            MOVE.L  #$00FF0000,D1
            TRAP    #15
            MOVE.B  #81,D0
            MOVE.L  #$00AA0000,D1
            TRAP    #15

            LEA     MAPDATA,A0
            MOVE.B  #87,D0
            CLR.W   D2
            MOVE.W  #BLCHEIGH,D4
            MOVE.W  #(SCRHEIGH/BLCHEIGH)-1,D6
            
.CLOOP      CLR.W   D1
            MOVE.W  #BLCWIDTH,D3
            MOVE.W  #(SCRWIDTH/BLCWIDTH)-1,D5 ; VECES DE INTERACIÓN POR X: REINICIAR PARA DIBUJAR LA FILA COMPLETA
            
.RLOOP      TST.B   (A0)+ ; A0 APUNTA A LAS POSICIONES DEL MAPA MODIFICANDO EL FLAG Z 
            BEQ     .NEXT ; SI ES Z = 1 SALTAR
            TRAP    #15   ; SI ES Z = 0 SE LLAMA A TRAP 15 PARA DIBUJAR
            
.NEXT       MOVE.W  D3,D1
            ADD.W   #BLCWIDTH,D3
            DBRA.W  D5,.RLOOP
            ; AQUI SE BAJA A LA SIGUIENTE FILA, VOLVIEDO AL INICIO DE X Y BAJAR Y
            MOVE.W  D4,D2       
            ADD.W   #BLCWIDTH,D4
            DBRA.W  D6,.CLOOP


            MOVEM.L (A7)+,D0-D6/A0

            RTS

; --- DATA ---------------------------------------------------------------------

