00012AB8                         10871  
00012AB8                         10872  ; --- SCREEN RELATED CONSTANTS ----------------------------------------------------------------
00012AB8                         10873  
00012AB8  =00000280              10874  SCRWIDTH    EQU     640                 ; SCREEN WIDTH
00012AB8  =000001E0              10875  SCRHEIGH    EQU     480                 ; SCREEN HEIGHT
00012AB8  =00000064              10876  SCRFPS      EQU     100                  ; SCREEN FRAMES PER SECOND
00012AB8                         10877  
00012AB8                         10878  ; --- TRAP RELATED CONSTANTS ------------------------------------------------------------------
00012AB8  =00000001              10879  TRAPSCR    EQU     1                   ; DOUBLE BUFFER TRAP NUMBER
00012AB8  =00000002              10880  TRAPKEY    EQU     2                   
00012AB8  =00000003              10881  TRAPPLOT   EQU     3                    
00012AB8                         10882  
00012AB8                         10883  ; --- INTERRUPT NUMBERS -----------------------------------------------------------------------
00012AB8  =00000001              10884  SCRINTN     EQU     1                   ; SCREEN TIMED INTERRUPT NUMBER
00012AB8                         10885  
00012AB8                         10886  ; --- KEYCODES --------------------------------------------------------------------------------
00012AB8                         10887  
00012AB8  =00000041              10888  KBDLEFT     EQU     'A'                 ; MOVE LEFT KEY
00012AB8  =00000044              10889  KBDRIGHT    EQU     'D'                 ; MOVE RIGHT KEY
00012AB8  =00000057              10890  KBDUP       EQU     'W'                 ; MOVE UP KEY
00012AB8  =00000053              10891  KBDDOWN     EQU     'S'                 ; MOVE DOWN KEY
00012AB8  =00000020              10892  KBDSPACE    EQU     $20                 ; SPACE KEY
00012AB8  =00000050              10893  KBDPAUSE    EQU     'P'                 ; PAUSE KEY
00012AB8  =0000004D              10894  KBDFIRE1    EQU     'M'                 ; WAIT ASIGNATION
00012AB8  =0000004E              10895  KBDFIRE2    EQU     'N'                 ; WAIT ASIGNATION
