000023DE                          1029              ; INSTALL SCREEN PLOT TRAP
000023DE  21FC 00002450 0084      1030              MOVE.L  #SCRPLOT,($80+TRAPSCR*4)
000023E6                          1031              ; INSTALL KEY TRAP
000023E6  21FC 00002480 0088      1032              MOVE.L  #KBDUPD,($80+TRAPKEY*4)
000023EE                          1033              ; INSTALL PLOT TRAP
000023EE  21FC 00001004 008C      1034              MOVE.L #PLOT,($80+TRAPPLOT*4)
000023F6                          1035              ; INSTALL INTERRUPTION FOR THE PLOT
000023F6  21FC 0000246A 0064      1036              MOVE.L  #SCRTIM,($60+SCRINTN*4)
